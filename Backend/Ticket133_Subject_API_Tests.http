@baseUrl = http://localhost:5084
@token = REPLACE_WITH_JWT
@subjectId = 1
@semesterId = 1

### Existing - List
GET {{baseUrl}}/api/v1/subjects
Authorization: Bearer {{token}}

### Existing - Search
GET {{baseUrl}}/api/v1/subjects/search?search=CS
Authorization: Bearer {{token}}

### Existing - Details
GET {{baseUrl}}/api/v1/subjects/{{subjectId}}
Authorization: Bearer {{token}}

### Existing - List filtered by semester
GET {{baseUrl}}/api/v1/subjects?semesterId={{semesterId}}&status=1
Authorization: Bearer {{token}}

### Ticket 133 - Create
POST {{baseUrl}}/api/v1/subjects
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subjectCode": "CS305",
  "subjectName": "Operating Systems",
  "courseId": 1,
  "branchId": 1,
  "semesterId": 1,
  "credits": 4.00,
  "subjectType": "THEORY",
  "description": "Operating system concepts",
  "status": 1
}

### Ticket 133 - Update
PUT {{baseUrl}}/api/v1/subjects/{{subjectId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subjectCode": "CS305",
  "subjectName": "Advanced Operating Systems",
  "courseId": 1,
  "branchId": 1,
  "semesterId": 1,
  "credits": 5.00,
  "subjectType": "THEORY",
  "description": "Updated operating system concepts",
  "status": 1
}
